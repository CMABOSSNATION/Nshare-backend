<!--
  AndroidManifest.xml additions for NetShare WireGuard edition.
  Merge these into your existing android/app/src/main/AndroidManifest.xml
  (replace the Cloudflare-era service entry if present).
-->

<!-- ── Permissions ──────────────────────────────────────────────── -->
<uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
<!-- VPN service is self-declared by VpnService; no extra permission needed -->

<!-- ── Inside <application> ─────────────────────────────────────── -->
<service
    android:name=".NetShareVpnService"
    android:exported="false"
    android:foregroundServiceType="specialUse"
    android:permission="android.permission.BIND_VPN_SERVICE">
    <intent-filter>
        <action android:name="android.net.VpnService" />
    </intent-filter>
    <!-- Required for Android 14+ foreground service type declaration -->
    <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="VPN tunneling for internet sharing" />
</service>
